{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "cache": {
        "disabled": false
      },
      "ios": {
        "simulator": true,
        "env": {
          "EXPO_NO_CAPABILITY_SYNC": "1"
        }
      }
    },
    "preview": {
      "distribution": "internal",
      "cache": {
        "disabled": false
      },
      "ios": {
        "simulator": false,
        "env": {
          "EXPO_NO_CAPABILITY_SYNC": "1"
        }
      }
    },
    "production": {
      "distribution": "store",
      "cache": {
        "disabled": false
      },
      "ios": {
        "simulator": false,
        "env": {
          "EXPO_NO_CAPABILITY_SYNC": "1"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}